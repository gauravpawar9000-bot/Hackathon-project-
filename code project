<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AccessEd - Breaking Financial Barriers to Education</title>
    <!-- Load Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Use Inter font family for a clean look -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        /* Custom Styles based on Requirements */
        :root {
            --color-primary: #1A73E8; /* Blue */
            --color-light-gray: #F5F5F5;
            --color-white: #FFFFFF;
        }
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--color-white);
        }
        .text-primary { color: var(--color-primary); }
        .bg-primary { background-color: var(--color-primary); }
        .bg-light-gray { background-color: var(--color-light-gray); }
        .btn-primary {
            background-color: var(--color-primary);
            transition: all 0.3s ease;
        }
        .btn-primary:hover {
            background-color: #155bb5; /* Slightly darker blue */
            box-shadow: 0 4px 12px rgba(26, 115, 232, 0.4);
        }
        /* Custom form group styling for focus */
        .input-focus:focus {
            border-color: var(--color-primary);
            box-shadow: 0 0 0 3px rgba(26, 115, 232, 0.3);
        }
        /* Style for the "Apply Link" to look slightly different */
        .btn-apply {
            background-color: #f97316; /* Optional orange highlight */
        }
        .btn-apply:hover {
            background-color: #ea580c;
        }
        /* Scroll offset for fixed header navigation */
        section {
            padding-top: 6rem; /* Space for fixed header */
            margin-top: -6rem;
        }
    </style>
</head>
<body class="text-gray-800">

    <!-- Navbar -->
    <header class="sticky top-0 z-50 bg-white shadow-md">
        <nav class="container mx-auto px-4 py-4 flex justify-between items-center">
            <a href="#home" class="text-2xl font-bold text-primary">AccessEd</a>
            <div class="space-x-4 flex items-center">
                <a href="#home" class="hover:text-primary transition duration-300 hidden sm:inline">Home</a>
                <a href="#scholarships" class="hover:text-primary transition duration-300 hidden sm:inline">Scholarships</a>
                <a href="#fee-support" class="hover:text-primary transition duration-300 hidden sm:inline">Fee Support</a>
                <a href="#contact" class="hover:text-primary transition duration-300 hidden sm:inline">Contact</a>
                <a href="#fee-support" class="sm:hidden btn-primary text-white px-4 py-2 rounded-full text-sm shadow-lg">Get Help</a>
            </div>
        </nav>
    </header>

    <!-- Home Page (Hero Section) -->
    <section id="home" class="pt-24 pb-16 md:pt-32 md:pb-24 bg-light-gray">
        <div class="container mx-auto px-4 text-center">
            <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold mb-4 leading-tight text-gray-900">
                Helping Students Overcome Financial Barriers in Education
            </h1>
            <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto mb-8">
                Financial exclusion prevents millions from reaching their full potential. We bridge the gap by connecting talented, lower-income students directly with dedicated corporate sponsors.
            </p>

            <div class="flex flex-col sm:flex-row justify-center space-y-4 sm:space-y-0 sm:space-x-6">
                <a href="#scholarships" class="btn-primary text-white font-semibold px-8 py-4 rounded-xl shadow-lg hover:shadow-xl transform hover:scale-[1.02] transition duration-300">
                    Find Scholarships
                </a>
                <a href="#fee-support" class="bg-white text-primary border-2 border-primary font-semibold px-8 py-4 rounded-xl shadow-lg hover:bg-gray-50 transform hover:scale-[1.02] transition duration-300">
                    Request Fee Support
                </a>
            </div>
        </div>
    </section>

    <!-- Impact Statistics/Testimonial Section (Optional Feature) -->
    <section id="impact" class="py-16 bg-white">
        <div class="container mx-auto px-4">
            <h2 class="text-3xl font-bold text-center mb-12 text-gray-900">Our Impact So Far</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Stat 1 -->
                <div class="bg-light-gray p-6 rounded-xl text-center shadow-md">
                    <p class="text-4xl font-extrabold text-primary mb-2">₹1.2 Cr</p>
                    <p class="text-gray-600 font-semibold">Total Funds Facilitated</p>
                </div>
                <!-- Stat 2 -->
                <div class="bg-light-gray p-6 rounded-xl text-center shadow-md">
                    <p class="text-4xl font-extrabold text-primary mb-2">450+</p>
                    <p class="text-gray-600 font-semibold">Students Supported</p>
                </div>
                <!-- Stat 3 -->
                <div class="bg-light-gray p-6 rounded-xl text-center shadow-md">
                    <p class="text-4xl font-extrabold text-primary mb-2">20</p>
                    <p class="text-gray-600 font-semibold">Corporate Partners</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Scholarships Page -->
    <section id="scholarships" class="py-16 bg-light-gray">
        <div class="container mx-auto px-4">
            <h2 class="text-4xl font-bold text-center mb-12 text-gray-900">Scholarship Opportunities</h2>

            <!-- Scholarship Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

                <!-- Scholarship 1: Tech Innovators Fund -->
                <div class="bg-white p-6 rounded-xl shadow-lg border-t-4 border-primary hover:shadow-2xl transition duration-300">
                    <h3 class="text-2xl font-bold mb-2 text-gray-900">Tech Innovators Fund</h3>
                    <p class="text-sm text-gray-500 mb-4">Sponsored by Infosys employees</p>
                    <ul class="space-y-2 text-gray-600 mb-6">
                        <li><strong>Eligibility:</strong> Class 11-12 Science/Engineering Aspirants</li>
                        <li><strong>Amount:</strong> ₹50,000 annually</li>
                        <li><strong>Deadline:</strong> August 15, 2025</li>
                    </ul>
                    <a href="https://example.com/apply1" target="_blank" class="btn-apply text-white font-semibold px-6 py-3 rounded-xl block text-center shadow-md hover:shadow-lg transition duration-300">
                        Apply Now (External)
                    </a>
                </div>

                <!-- Scholarship 2: Future Leaders Grant -->
                <div class="bg-white p-6 rounded-xl shadow-lg border-t-4 border-primary hover:shadow-2xl transition duration-300">
                    <h3 class="text-2xl font-bold mb-2 text-gray-900">Future Leaders Grant</h3>
                    <p class="text-sm text-gray-500 mb-4">Sponsored by Wipro employees</p>
                    <ul class="space-y-2 text-gray-600 mb-6">
                        <li><strong>Eligibility:</strong> Undergraduate Arts/Commerce (1st & 2nd Year)</li>
                        <li><strong>Amount:</strong> ₹35,000 per semester</li>
                        <li><strong>Deadline:</strong> September 30, 2025</li>
                    </ul>
                    <a href="https://example.com/apply2" target="_blank" class="btn-apply text-white font-semibold px-6 py-3 rounded-xl block text-center shadow-md hover:shadow-lg transition duration-300">
                        Apply Now (External)
                    </a>
                </div>

                <!-- Scholarship 3: Community Builder Aid -->
                <div class="bg-white p-6 rounded-xl shadow-lg border-t-4 border-primary hover:shadow-2xl transition duration-300">
                    <h3 class="text-2xl font-bold mb-2 text-gray-900">Community Builder Aid</h3>
                    <p class="text-sm text-gray-500 mb-4">Sponsored by HDFC Bank employees</p>
                    <ul class="space-y-2 text-gray-600 mb-6">
                        <li><strong>Eligibility:</strong> All students (Class 8-10) with local impact</li>
                        <li><strong>Amount:</strong> ₹15,000 one-time grant</li>
                        <li><strong>Deadline:</strong> Ongoing</li>
                    </ul>
                    <a href="https://example.com/apply3" target="_blank" class="btn-apply text-white font-semibold px-6 py-3 rounded-xl block text-center shadow-md hover:shadow-lg transition duration-300">
                        Apply Now (External)
                    </a>
                </div>

            </div>
        </div>
    </section>

    <!-- Fee Support Request Page -->
    <section id="fee-support" class="py-16 bg-white">
        <div class="container mx-auto px-4 max-w-3xl">
            <h2 class="text-4xl font-bold text-center mb-4 text-gray-900">Direct Fee Support Request</h2>
            <p class="text-center text-lg text-gray-600 mb-10">Use this confidential form to request immediate fee assistance. Your financial details are kept private and used only for matching with dedicated sponsors.</p>

            <!-- Fee Support Form -->
            <form id="feeSupportForm" class="bg-light-gray p-8 rounded-xl shadow-xl">
                <div class="space-y-6">

                    <!-- Personal Information -->
                    <div>
                        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                        <input type="text" id="name" name="name" required class="w-full p-3 border border-gray-300 rounded-lg input-focus">
                    </div>

                    <div>
                        <label for="school" class="block text-sm font-medium text-gray-700 mb-1">School/College Name</label>
                        <input type="text" id="school" name="school" required class="w-full p-3 border border-gray-300 rounded-lg input-focus">
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <label for="class_year" class="block text-sm font-medium text-gray-700 mb-1">Class/Year of Study</label>
                            <input type="text" id="class_year" name="class_year" required class="w-full p-3 border border-gray-300 rounded-lg input-focus">
                        </div>
                        <div>
                            <label for="contact" class="block text-sm font-medium text-gray-700 mb-1">Contact Email/Phone</label>
                            <input type="text" id="contact" name="contact" required class="w-full p-3 border border-gray-300 rounded-lg input-focus">
                        </div>
                    </div>

                    <!-- Financial Information (CRITICAL) -->
                    <div>
                        <label for="income" class="block text-sm font-bold text-primary mb-1">Family Annual Income (₹)</label>
                        <input type="number" id="income" name="income" required class="w-full p-3 border-2 border-primary rounded-lg input-focus" placeholder="e.g., 250000">
                        <p class="text-xs text-gray-500 mt-1">This information is critical for sponsor matching.</p>
                    </div>

                    <div>
                        <label for="reason" class="block text-sm font-bold text-primary mb-1">Reason for Support Request</label>
                        <textarea id="reason" name="reason" rows="4" required class="w-full p-3 border-2 border-primary rounded-lg input-focus" placeholder="Please detail your financial condition and the specific fee amount needed."></textarea>
                    </div>

                    <!-- Document Upload (Simulated for Hackathon) -->
                    <div>
                        <label for="documents" class="block text-sm font-medium text-gray-700 mb-1">Upload Documents (Optional)</label>
                        <input type="file" id="documents" name="documents" class="w-full p-3 bg-white border border-gray-300 rounded-lg">
                        <p class="text-xs text-gray-500 mt-1">Examples: Income certificate, fee receipt, or school letter.</p>
                    </div>

                    <!-- Submission Button and Message Box -->
                    <button type="submit" class="btn-primary text-white font-semibold w-full py-3 rounded-xl shadow-lg mt-4">
                        Submit Confidential Request
                    </button>
                    <div id="messageBox" class="mt-4 p-3 rounded-lg text-center font-medium hidden" role="alert"></div>

                </div>
            </form>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-16 bg-light-gray">
        <div class="container mx-auto px-4 max-w-2xl text-center">
            <h2 class="text-4xl font-bold mb-4 text-gray-900">Get in Touch</h2>
            <p class="text-lg text-gray-600 mb-8">Have questions about the process, eligibility, or sponsoring a student? Contact our team directly.</p>

            <div class="space-y-4 text-left inline-block">
                <p class="text-gray-700 flex items-center">
                    <svg class="w-6 h-6 mr-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    <strong>Email:</strong> support@accessed.org
                </p>
                <p class="text-gray-700 flex items-center">
                    <svg class="w-6 h-6 mr-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.128a11.042 11.042 0 005.516 5.516l1.128-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                    <strong>Phone:</strong> +91 98765 43210
                </p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-800 text-white py-6">
        <div class="container mx-auto px-4 text-center text-sm">
            &copy; 2025 AccessEd | Breaking Financial Barriers. A Hackathon Project for SDG 4.
        </div>
    </footer>

    <!-- JavaScript for Form Handling and Message Box -->
    <script>
        document.getElementById('feeSupportForm').addEventListener('submit', function(event) {
            event.preventDefault();
            
            const form = event.target;
            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());
            const messageBox = document.getElementById('messageBox');
            
            // --- CRITICAL DATA LOGGING ---
            console.log("--- Fee Support Request Submitted ---");
            console.log("Student Name:", data.name);
            console.log("School/College:", data.school);
            console.log("Class/Year:", data.class_year);
            console.log("Contact:", data.contact);
            console.log("FAMILY ANNUAL INCOME:", data.income);
            console.log("REASON FOR SUPPORT:", data.reason);
            
            // Simulate processing and show success message
            messageBox.textContent = 'Success! Your request has been securely submitted and is under confidential review for matching with a sponsor.';
            messageBox.classList.remove('hidden', 'bg-red-100', 'text-red-700');
            messageBox.classList.add('bg-green-100', 'text-green-700');

            // Reset the form after a short delay
            setTimeout(() => {
                form.reset();
            }, 3000); 
        });
    </script>
</body>
</html>
